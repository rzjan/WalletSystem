{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "RabbitMq": {
    "HostName": "localhost",
    "Port": 5672,
    "UserName": "wallet",
    "Exchange": "wallet.events"
  },
  "Outbox": {
    "BatchSize": 50,
    "PollIntervalMs": 1000
  },
  "Consumer": {
    "QueueName": "wallet.events.consumer",
    "Prefetch": 10,
    "MaxRetries": 3,
    "RetryDelayMs": 5000
  }
}